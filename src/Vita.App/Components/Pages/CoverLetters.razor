@page "/cover-letters"
@attribute [Authorize]
@inject UserSession Session
@inject CoverLetterStore LetterStore
@inject ResumeStore ResumeStore
@inject AiAssistantService Ai
@inject ToastService Toasts
@inject NavigationManager Nav

<PageTitle>Cartas de apresentação · Vita</PageTitle>

@if (_loading)
{
    <div class="page-loader"><span class="spinner"></span></div>
}
else if (_selected is null)
{
    <div class="page-head">
        <div class="page-head-main">
            <span class="eyebrow"><span class="dot"></span> Cartas que abrem portas</span>
            <h1 class="page-title">Cartas de <em>apresentação</em></h1>
            <p class="page-sub">Uma carta curta, específica e baseada apenas no que está no seu currículo. Gere um rascunho local ou peça à IA para escrever com o seu tom.</p>
        </div>
        <div class="page-actions">
            <button class="btn btn-primary" @onclick="() => OpenNew()">
                <Icon Name="plus" Size="16" /> Nova carta
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-error" style="margin-bottom:14px"><Icon Name="alert" Size="16" /><span>@_error</span></div>
    }

    @if (_letters.Count == 0)
    {
        <div class="empty-state">
            <div class="orb"><Icon Name="mail" Size="22" /></div>
            <h3>Nenhuma carta ainda.</h3>
            <p>Escolha uma vaga, selecione seu currículo e gere uma carta pronta para revisar. O rascunho local funciona sem IA.</p>
            <button class="btn btn-primary" @onclick="() => OpenNew()"><Icon Name="plus" Size="16" /> Criar primeira carta</button>
        </div>
    }
    else
    {
        <div class="letter-list">
            @foreach (var letter in _letters)
            {
                <article class="card letter-card card-hover" @onclick="() => Select(letter)">
                    <div class="row-between" style="align-items:flex-start">
                        <div style="min-width:0">
                            <span class="muted-label">@(string.IsNullOrWhiteSpace(letter.Company) ? "Carta" : letter.Company)</span>
                            <h3 style="margin-top:3px">@(string.IsNullOrWhiteSpace(letter.Role) ? letter.Title : letter.Role)</h3>
                        </div>
                        <span class="badge badge-outline">@LanguageLabel(letter.Language)</span>
                    </div>
                    <p class="letter-preview-snippet">@PreviewSnippet(letter.Body)</p>
                    <div class="letter-card-foot">
                        <span class="tiny muted"><Icon Name="clock" Size="11" /> @Human(letter.UpdatedAt)</span>
                        <div class="row" style="gap:2px">
                            <a class="icon-btn" title="Baixar PDF" href="@($"/api/cover-letters/{letter.Id}/pdf")" @onclick:stopPropagation>
                                <Icon Name="download" Size="15" />
                            </a>
                            <button class="icon-btn danger" title="Excluir" @onclick="() => AskDelete(letter)" @onclick:stopPropagation>
                                <Icon Name="trash" Size="15" />
                            </button>
                            <button class="icon-btn" title="Abrir" @onclick="() => Select(letter)" @onclick:stopPropagation>
                                <Icon Name="arrow-right" Size="15" />
                            </button>
                        </div>
                    </div>
                </article>
            }

            <button class="create-card" @onclick="() => OpenNew()">
                <span class="plus-orb"><Icon Name="plus" Size="20" /></span>
                <strong>Criar nova carta</strong>
                <span>Rascunho local ou gerado com IA</span>
            </button>
        </div>
    }
}
else
{
    <div class="editor-top">
        <div class="crumbs">
            <button class="crumbs-btn" @onclick="BackToList"><Icon Name="arrow-left" Size="12" /> Cartas</button>
            <Icon Name="chevron-right" Size="12" />
            <span>@(_selected.Company is { Length: > 0 } c ? c : "Nova carta")</span>
        </div>
        <div class="editor-title-row">
            <input class="editor-title-input" @bind="_selected.Title" @bind:event="oninput" @bind:after="Touch" aria-label="Título da carta" />
            <span class="save-state @(_saving ? "saving" : "")">
                <span class="dot"></span>
                @SaveLabel
            </span>
        </div>
        <div class="row-wrap">
            <span class="chip"><Icon Name="user" Size="12" /> @ResumeLabel(_selected.ResumeId)</span>
            <span class="chip"><Icon Name="globe" Size="12" /> @LanguageLabel(_selected.Language)</span>
            <div class="spacer"></div>
            <a class="btn btn-ghost btn-sm" href="@($"/api/cover-letters/{_selected.Id}/pdf")">
                <Icon Name="download" Size="14" /> PDF
            </a>
            <button class="btn btn-accent btn-sm" @onclick="GenerateWithAi" disabled="@_aiBusy">
                @if (_aiBusy) { <span class="spinner spinner-sm"></span> } else { <Icon Name="sparkles" Size="14" /> }
                Gerar com IA
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-error" style="margin-bottom:14px">
            <Icon Name="alert" Size="16" />
            <span>@_error</span>
        </div>
    }

    <div class="letter-grid">
        <section class="card card-pad stack">
            <div class="form-grid">
                <label class="field">
                    <span>Empresa</span>
                    <input @bind="_selected.Company" @bind:event="oninput" @bind:after="Touch" placeholder="Ex.: Nubank" />
                </label>
                <label class="field">
                    <span>Vaga</span>
                    <input @bind="_selected.Role" @bind:event="oninput" @bind:after="Touch" placeholder="Ex.: Product Designer Sênior" />
                </label>
                <label class="field">
                    <span>Currículo base</span>
                    <select class="select" @bind="_resumeId" @bind:after="ResumeChanged">
                        <option value="">Sem currículo</option>
                        @foreach (var resume in _resumes)
                        {
                            <option value="@resume.Id">@resume.Title</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Tom</span>
                    <select class="select" @bind="_selected.Tone" @bind:after="Touch">
                        <option value="profissional">Profissional</option>
                        <option value="entusiasta">Entusiasta</option>
                        <option value="direto">Direto</option>
                        <option value="consultivo">Consultivo</option>
                    </select>
                </label>
                <label class="field">
                    <span>Idioma</span>
                    <select class="select" @bind="_selected.Language" @bind:after="Touch">
                        <option value="pt">Português</option>
                        <option value="en">English</option>
                        <option value="es">Español</option>
                    </select>
                </label>
                <div class="field">
                    <span>Rascunho</span>
                    <button class="btn btn-ghost btn-sm" style="height:40px" @onclick="GenerateLocal">
                        <Icon Name="refresh" Size="14" /> Regerar local
                    </button>
                </div>
            </div>

            <label class="field">
                <span>Descrição da vaga</span>
                <textarea class="textarea" rows="4" @bind="_selected.JobDescription" @bind:event="oninput" @bind:after="Touch"
                          placeholder="Cole a descrição da vaga para alinhar a carta às palavras-chave certas."></textarea>
            </label>

            <label class="field">
                <span>Corpo da carta</span>
                <textarea class="textarea letter-editor" rows="18" @bind="_selected.Body" @bind:event="oninput" @bind:after="Touch"
                          placeholder="A carta começa aqui. Use um rascunho local ou gere com IA e revise antes de enviar."></textarea>
            </label>

            <div class="row-wrap">
                <button class="btn btn-primary btn-sm" @onclick="SaveNow" disabled="@_saving">
                    @if (_saving) { <span class="spinner spinner-sm"></span> } else { <Icon Name="save" Size="14" /> }
                    Salvar carta
                </button>
                <button class="btn btn-ghost btn-sm" @onclick="() => AskDelete(_selected!)">
                    <Icon Name="trash" Size="14" /> Excluir
                </button>
                <div class="spacer"></div>
                <span class="hint-ai"><Icon Name="info" Size="12" /> Fatos do currículo, sem invenções.</span>
            </div>
        </section>

        <aside class="letter-preview-wrap">
            <div class="letter-paper">
                <div class="lp-name">@PreviewName</div>
                <div class="lp-contact">@PreviewContact</div>
                <div class="lp-rule"></div>
                <div class="lp-body">@(_selected.Body.Length == 0 ? "Sua carta aparece aqui enquanto você escreve." : _selected.Body)</div>
            </div>
            <p class="tiny muted" style="margin-top:10px;text-align:center">Prévia aproximada. O PDF usa a mesma diagramação.</p>
        </aside>
    </div>
}

<Modal Open="_newOpen" Title="Nova carta de apresentação" Subtitle="Escolha a vaga e o ponto de partida. Você pode gerar de novo e editar tudo depois." OnClose="() => _newOpen = false" Size="lg">
    <ChildContent>
        <div class="form-grid">
            <label class="field">
                <span>Empresa</span>
                <input @bind="_newCompany" placeholder="Ex.: Nubank" />
            </label>
            <label class="field">
                <span>Vaga</span>
                <input @bind="_newRole" placeholder="Ex.: Product Designer Sênior" />
            </label>
            <label class="field">
                <span>Currículo base</span>
                <select class="select" @bind="_newResumeId">
                    <option value="">Sem currículo</option>
                    @foreach (var resume in _resumes)
                    {
                        <option value="@resume.Id">@resume.Title</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>Idioma</span>
                <select class="select" @bind="_newLanguage">
                    <option value="pt">Português</option>
                    <option value="en">English</option>
                    <option value="es">Español</option>
                </select>
            </label>
            <label class="field">
                <span>Tom</span>
                <select class="select" @bind="_newTone">
                    <option value="profissional">Profissional</option>
                    <option value="entusiasta">Entusiasta</option>
                    <option value="direto">Direto</option>
                    <option value="consultivo">Consultivo</option>
                </select>
            </label>
            <div class="field">
                <span>Como gerar</span>
                <div class="segmented">
                    <button class="@(_newMode == "local" ? "active" : "")" @onclick='() => _newMode = "local"'>Rascunho local</button>
                    <button class="@(_newMode == "ai" ? "active" : "")" @onclick='() => _newMode = "ai"'>Com IA</button>
                </div>
            </div>
        </div>

        <label class="field">
            <span>Descrição da vaga (opcional)</span>
            <textarea class="textarea" rows="6" @bind="_newJob" placeholder="Cole a descrição para uma carta mais específica."></textarea>
        </label>

        @if (_newMode == "ai")
        {
            <div class="alert alert-info">
                <Icon Name="sparkles" Size="16" />
                <span>A IA usa o currículo selecionado e a descrição da vaga. Se o provedor não estiver disponível, criamos um rascunho local automaticamente.</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_newError))
        {
            <div class="alert alert-error"><Icon Name="alert" Size="16" /><span>@_newError</span></div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _newOpen = false">Cancelar</button>
        <button class="btn btn-primary" @onclick="CreateNew" disabled="@_newBusy">
            @if (_newBusy) { <span class="spinner spinner-sm"></span> }
            Criar carta
        </button>
    </Footer>
</Modal>

<Modal Open="_deleteOpen" Title="Excluir carta?" Subtitle="Esta ação não pode ser desfeita." OnClose="() => _deleteOpen = false">
    <ChildContent>
        @if (_deleteTarget is not null)
        {
            <div class="alert alert-warn">
                <Icon Name="alert" Size="17" />
                <span>A carta <strong>@_deleteTarget.Title</strong> será removida deste computador.</span>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _deleteOpen = false">Cancelar</button>
        <button class="btn btn-danger" @onclick="DeleteCurrent">Excluir definitivamente</button>
    </Footer>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "company")] public string? CompanyQuery { get; set; }
    [SupplyParameterFromQuery(Name = "role")] public string? RoleQuery { get; set; }

    private AppUser? _user;
    private List<CoverLetterEntity> _letters = new();
    private List<ResumeEntity> _resumes = new();
    private Dictionary<Guid, ResumeDocument> _documents = new();
    private CoverLetterEntity? _selected;
    private Guid? _resumeId;
    private bool _loading = true;
    private bool _saving;
    private bool _dirty;
    private DateTime? _lastSaved;
    private string? _error;
    private CancellationTokenSource? _saveCts;

    private bool _newOpen, _deleteOpen, _newBusy, _aiBusy;
    private string _newCompany = string.Empty;
    private string _newRole = string.Empty;
    private string _newTone = "profissional";
    private string _newLanguage = "pt";
    private string _newJob = string.Empty;
    private string _newMode = "local";
    private Guid? _newResumeId;
    private string? _newError;
    private CoverLetterEntity? _deleteTarget;

    private string SaveLabel => _saving ? "Salvando…" : _dirty ? "Alterações não salvas" : _lastSaved is { } t ? $"Salvo às {t:HH:mm}" : "Salvo";

    private ResumeDocument PreviewDocument
    {
        get
        {
            if (_selected is not null && _selected.ResumeId is { } id && _documents.TryGetValue(id, out var doc)) return doc;
            return new ResumeDocument { Contact = { FullName = _user?.FullName ?? "" } };
        }
    }

    private string PreviewName => string.IsNullOrWhiteSpace(PreviewDocument.Contact.FullName) ? "Seu nome" : PreviewDocument.Contact.FullName;
    private string PreviewContact
    {
        get
        {
            var c = PreviewDocument.Contact;
            var parts = new[] { c.Email, c.Phone, c.Location, c.LinkedIn }.Where(p => !string.IsNullOrWhiteSpace(p));
            return string.Join("  ·  ", parts);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _user = await Session.GetUserAsync();
        if (_user is null) return;
        _resumes = await ResumeStore.ListAsync(_user.Id);
        foreach (var resume in _resumes)
        {
            var doc = Json.Deserialize<ResumeDocument>(resume.DataJson);
            if (doc is not null) _documents[resume.Id] = doc;
        }
        await LoadAsync();

        if (!string.IsNullOrWhiteSpace(CompanyQuery) || !string.IsNullOrWhiteSpace(RoleQuery))
        {
            OpenNew(CompanyQuery, RoleQuery);
        }
    }

    private async Task LoadAsync()
    {
        if (_user is null) return;
        _loading = true;
        _letters = await LetterStore.ListAsync(_user.Id);
        _loading = false;
    }

    private void OpenNew(string? company = null, string? role = null)
    {
        _newCompany = company ?? string.Empty;
        _newRole = role ?? string.Empty;
        _newJob = string.Empty;
        _newTone = "profissional";
        _newLanguage = "pt";
        _newMode = "local";
        _newResumeId = _resumes.FirstOrDefault(r => r.IsDefault)?.Id ?? _resumes.FirstOrDefault()?.Id;
        _newError = null;
        _newOpen = true;
    }

    private void Select(CoverLetterEntity letter)
    {
        _selected = letter;
        _resumeId = letter.ResumeId;
        _error = null;
        _dirty = false;
        _lastSaved = letter.UpdatedAt.ToLocalTime();
    }

    private void BackToList()
    {
        _selected = null;
        _error = null;
    }

    private async Task CreateNew()
    {
        if (_user is null) return;
        if (string.IsNullOrWhiteSpace(_newCompany) && string.IsNullOrWhiteSpace(_newRole))
        {
            _newError = "Informe ao menos a empresa ou a vaga.";
            return;
        }

        _newBusy = true;
        _newError = null;
        try
        {
            var document = _newResumeId is { } id && _documents.TryGetValue(id, out var doc)
                ? doc
                : new ResumeDocument { Contact = { FullName = _user.FullName } };

            string? body = null;
            var fallback = false;
            if (_newMode == "ai")
            {
                try
                {
                    body = await Ai.CoverLetterAsync(_user.Id, document, _newCompany, _newRole, _newJob, _newLanguage, _newTone);
                }
                catch (AiException ex)
                {
                    _newError = ex.Message + " Criamos um rascunho local para você continuar.";
                    fallback = true;
                }
            }
            body ??= CoverLetterTemplates.Generate(document, _newCompany, _newRole, _newJob, _newLanguage, _newTone);

            var title = string.IsNullOrWhiteSpace(_newRole)
                ? $"Carta · {_newCompany}"
                : string.IsNullOrWhiteSpace(_newCompany) ? $"Carta · {_newRole}" : $"{_newRole} · {_newCompany}";
            var entity = new CoverLetterEntity
            {
                UserId = _user.Id,
                ResumeId = _newResumeId,
                Title = title,
                Company = _newCompany.Trim(),
                Role = _newRole.Trim(),
                Tone = _newTone,
                Language = _newLanguage,
                JobDescription = _newJob.Trim(),
                Body = body.Trim()
            };
            await LetterStore.SaveAsync(entity);
            _newOpen = false;
            await LoadAsync();
            Select(entity);
            Toasts.Success(fallback ? "Carta criada com rascunho local." : "Carta criada. Revise e ajuste o tom.");
        }
        finally
        {
            _newBusy = false;
        }
    }

    private void ResumeChanged()
    {
        if (_selected is null) return;
        _selected.ResumeId = _resumeId;
        Touch();
    }

    private void GenerateLocal()
    {
        if (_selected is null) return;
        var document = PreviewDocument;
        _selected.Body = CoverLetterTemplates.Generate(document, _selected.Company, _selected.Role,
            _selected.JobDescription, _selected.Language, _selected.Tone);
        _error = null;
        Touch();
        Toasts.Success("Rascunho local gerado. Revise antes de enviar.");
    }

    private async Task GenerateWithAi()
    {
        if (_selected is null || _user is null) return;
        if (string.IsNullOrWhiteSpace(_selected.Company) && string.IsNullOrWhiteSpace(_selected.Role))
        {
            _error = "Informe a empresa ou a vaga antes de gerar a carta.";
            return;
        }
        _aiBusy = true;
        _error = null;
        try
        {
            var body = await Ai.CoverLetterAsync(_user.Id, PreviewDocument, _selected.Company, _selected.Role,
                _selected.JobDescription, _selected.Language, _selected.Tone);
            if (string.IsNullOrWhiteSpace(body))
            {
                _error = "A IA não retornou texto. Tente novamente ou use o rascunho local.";
                return;
            }
            _selected.Body = body.Trim();
            Touch();
            Toasts.Success("Carta gerada com IA. Revise os fatos antes de enviar.");
        }
        catch (AiException ex)
        {
            _error = ex.Message;
            if (string.IsNullOrWhiteSpace(_selected.Body))
            {
                _selected.Body = CoverLetterTemplates.Generate(PreviewDocument, _selected.Company, _selected.Role,
                    _selected.JobDescription, _selected.Language, _selected.Tone);
                Touch();
                Toasts.Info("Criamos um rascunho local enquanto a IA não está disponível.");
            }
        }
        finally
        {
            _aiBusy = false;
        }
    }

    private void Touch()
    {
        if (_loading || _selected is null) return;
        _dirty = true;
        _saveCts?.Cancel();
        _saveCts?.Dispose();
        _saveCts = new CancellationTokenSource();
        var token = _saveCts.Token;
        _ = DebouncedSaveAsync(token);
    }

    private async Task DebouncedSaveAsync(CancellationToken token)
    {
        try { await Task.Delay(900, token); }
        catch (OperationCanceledException) { return; }
        if (token.IsCancellationRequested) return;
        await InvokeAsync(SaveNow);
    }

    private async Task SaveNow()
    {
        if (_selected is null) return;
        _saving = true;
        StateHasChanged();
        try
        {
            _selected.ResumeId = _resumeId;
            await LetterStore.SaveAsync(_selected);
            _dirty = false;
            _lastSaved = DateTime.Now;
        }
        catch (Exception)
        {
            Toasts.Error("Não foi possível salvar a carta. Tente novamente.");
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void AskDelete(CoverLetterEntity letter)
    {
        _deleteTarget = letter;
        _deleteOpen = true;
    }

    private async Task DeleteCurrent()
    {
        if (_deleteTarget is null || _user is null) return;
        await LetterStore.DeleteAsync(_deleteTarget.Id, _user.Id);
        _deleteOpen = false;
        if (_selected?.Id == _deleteTarget.Id) _selected = null;
        _deleteTarget = null;
        await LoadAsync();
        Toasts.Success("Carta excluída.");
    }

    public void Dispose()
    {
        _saveCts?.Cancel();
        _saveCts?.Dispose();
    }

    private string ResumeLabel(Guid? id) => id is { } value
        ? _resumes.FirstOrDefault(r => r.Id == value)?.Title ?? "Currículo removido"
        : "Sem currículo";

    private static string LanguageLabel(string lang) => lang switch { "en" => "EN", "es" => "ES", _ => "PT" };

    private static string PreviewSnippet(string body)
    {
        var text = body.Replace("\r", " ").Replace("\n", " ").Trim();
        return TextAnalysis.Truncate(text, 190);
    }

    private static string Human(DateTime value)
    {
        var days = (DateTime.UtcNow - value).TotalDays;
        return days switch
        {
            < 1 => "hoje",
            < 2 => "ontem",
            < 30 => $"há {(int)days} dias",
            _ => value.ToString("d MMM", new CultureInfo("pt-BR"))
        };
    }
}
