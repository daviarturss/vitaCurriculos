<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Vita.App</RootNamespace>
    <AssemblyName>Vita</AssemblyName>
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <Product>Vita</Product>
    <Description>Currículo, ATS, vagas e assistente de carreira com IA, tudo local.</Description>
    <ApplicationIcon>Assets\vita.ico</ApplicationIcon>
    <UserSecretsId>vita-app-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vita.Core\Vita.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="QuestPDF" Version="2025.7.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- WinExe (Release) hides the console window, but the ASP.NET Core SDK only imports the
       Blazor framework scripts when OutputType is exactly "Exe". Add them back explicitly.
       The version comes from the SDK's own KnownAspNetCorePack item, so this follows SDK updates. -->
  <Target Name="IncludeBlazorFrameworkAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(OutputType)' == 'WinExe'">
    <PropertyGroup>
      <VitaNuGetRoot Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</VitaNuGetRoot>
      <VitaNuGetRoot Condition="'$(VitaNuGetRoot)' == ''">$(UserProfile)\.nuget\packages\</VitaNuGetRoot>
    </PropertyGroup>
    <ItemGroup>
      <_VitaAspNetCorePack Include="@(KnownAspNetCorePack)"
                           Condition="'%(Identity)' == 'Microsoft.AspNetCore.App.Internal.Assets'" />
    </ItemGroup>
    <Error Condition="'@(_VitaAspNetCorePack)' == ''"
           Text="Não foi possível localizar o pacote Microsoft.AspNetCore.App.Internal.Assets do SDK." />
    <ItemGroup>
      <Content Include="$(VitaNuGetRoot)microsoft.aspnetcore.app.internal.assets\%(_VitaAspNetCorePack.AspNetCorePackVersion)\_framework\blazor.web.js"
               Link="wwwroot\_framework\blazor.web.js"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
      <Content Include="$(VitaNuGetRoot)microsoft.aspnetcore.app.internal.assets\%(_VitaAspNetCorePack.AspNetCorePackVersion)\_framework\blazor.server.js"
               Link="wwwroot\_framework\blazor.server.js"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
    <Error Condition="!Exists('$(VitaNuGetRoot)microsoft.aspnetcore.app.internal.assets\%(_VitaAspNetCorePack.AspNetCorePackVersion)\_framework\blazor.web.js')"
           Text="Assets do Blazor não encontrados em $(VitaNuGetRoot)microsoft.aspnetcore.app.internal.assets. Verifique o cache do NuGet." />
  </Target>
</Project>
